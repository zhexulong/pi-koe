{
  "name": "pi-koe",
  "version": "0.1.0",
  "description": "Standalone, localhost-only voice gateway for GameBuddy — PTT capture, ASR, streamed MiMo TTS, resident Windows playback. Installable as a pi extension.",
  "type": "module",
  "private": true,
  "main": "./extensions/index.ts",
  "exports": { ".": "./extensions/index.ts" },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:all": "pnpm run build:protocol && pnpm run build",
    "build:protocol": "tsc --project packages/voice-protocol/tsconfig.json",
    "build:release-artifact": "node scripts/build-release-artifact.mjs",
    "test": "pnpm run build:protocol && pnpm run build && node --test dist/**/*.test.js",
    "test:all": "pnpm run test",
    "test:protocol": "pnpm run build:protocol && node --test packages/voice-protocol/dist/**/*.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:all": "pnpm run build:protocol && pnpm run typecheck",
    "typecheck:protocol": "tsc --project packages/voice-protocol/tsconfig.json --noEmit",
    "start": "node --use-env-proxy dist/main.js",
    "live-gate": "node scripts/run-pipeline-live-gate.mjs",
    "probe:groq": "node --use-env-proxy tools/run-groq-asr-probe.mjs",
    "v2-wire-rehearsal": "node --use-env-proxy scripts/run-v2-wire-rehearsal.mjs",
    "test:extension": "node scripts/extension-smoke.mjs"
  },
  "dependencies": {
    "@gamebuddy/voice-protocol": "file:./packages/voice-protocol"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "tts",
    "asr",
    "gamebuddy"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}